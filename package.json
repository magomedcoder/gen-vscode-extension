{
  "name": "gen",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "magomedcoder",
  "icon": "media/logo.png",
  "license": "MIT",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/magomedcoder/gen-vscode-extension"
  },
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gen.commentSelection",
        "title": "%command.commentSelection.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.commentFile",
        "title": "%command.commentFile.title%",
        "category": "%extension.category%"
      },
      {
        "command": "gen.openChat",
        "title": "%command.openChat.title%",
        "category": "%extension.category%"
      }
    ],
    "keybindings": [
      {
        "command": "gen.openChat",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      },
      {
        "command": "gen.commentSelection",
        "key": "ctrl+alt+/",
        "mac": "cmd+alt+/",
        "when": "editorHasSelection && editorTextFocus"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "gen",
          "title": "%viewsContainers.panel.gen.title%",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "gen": [
        {
          "type": "webview",
          "id": "gen.chatView",
          "name": "%views.gen.chatView.name%",
          "icon": "media/logo.svg"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "gen.commentSelection",
          "when": "editorHasSelection && editorTextFocus",
          "group": "gen@1"
        },
        {
          "command": "gen.commentFile",
          "when": "editorTextFocus",
          "group": "gen@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "yarn run check-types && yarn run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "package:vsix": "vsce package --yarn --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "ignore": "^7.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
